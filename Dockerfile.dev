FROM node:24-alpine

RUN apk add --no-cache libc6-compat

WORKDIR /app

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./

RUN pnpm install --ignore-scripts
RUN pnpm approve-builds --yes || true
RUN pnpm rebuild

COPY . .

RUN POSTGRES_URL=postgresql://build:build@localhost:5432/build pnpm build

EXPOSE 3000

CMD ["pnpm", "start"]