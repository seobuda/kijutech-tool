# Copia este archivo a .env y rellena los valores. .env NO se versiona.
# En producción: AUTH_SECRET, POSTGRES_PASSWORD y AI_ENCRYPTION_KEY son NUEVOS (no los de desarrollo).

# Contraseña de la base de datos (la usa docker-compose.yml)
POSTGRES_PASSWORD=
# Conexión desde el ordenador (scripts fuera de Docker); dentro de Docker la monta el compose
POSTGRES_URL=
BASE_URL=http://127.0.0.1:3000
# Secreto de las sesiones (JWT). Genera uno con:  openssl rand -base64 45
AUTH_SECRET=
# Clave maestra (64 caracteres hex) que cifra las claves guardadas de IA, ClickUp y Telegram.
# Genera una con:  openssl rand -hex 32   (para cambiarla, ver scripts/rotate-encryption-key.ts)
AI_ENCRYPTION_KEY=

# Usuario de pruebas SOLO para desarrollo (borrar antes de subir a un servidor)
OPS_TEST_EMAIL=
OPS_TEST_PASSWORD=

# Solo para db:seed (usuario inicial; sin valores por defecto)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
